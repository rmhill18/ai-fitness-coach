# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite (local file). For production, use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# ── CORS / Allowed Origins (comma-separated) ──────────────────────────────────
# Add your deployed frontend URL here for production
# ALLOWED_ORIGINS=https://yourapp.com,capacitor://localhost,http://localhost
